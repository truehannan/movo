#!/bin/sh
# Launcher for the Jev Desktop Agent.
#
# Prefers the isolated virtualenv created at install time (which holds the
# PyPI-only dependencies: typesafe-sdk, mss, pynput, PySide6). The venv is built
# with --system-site-packages so it can also use the distro's python3-gi /
# AT-SPI bindings, which are not on PyPI.
set -e

APP_HOME="/usr/lib/jev-desktop-agent"
VENV_PY="$APP_HOME/venv/bin/python3"

if [ -x "$VENV_PY" ]; then
    PY="$VENV_PY"
else
    PY="$(command -v python3)"
fi

export PYTHONPATH="$APP_HOME${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m app.main "$@"
