#!/bin/sh
# Launcher for Movo.
#
# On first launch the PyPI-only dependencies (PySide6, typesafe-sdk, mss,
# pynput) are installed into an isolated PER-USER virtualenv. This is done HERE
# rather than in the package postinst so a slow download never blocks or hangs
# the package manager.
#
# The venv lives under the user's data dir (NOT the root-owned /usr/lib), so a
# normal (non-root) launch can create it and pip-install into it without sudo.
# It uses --system-site-packages so the distro's python3-gi / AT-SPI bindings
# (which are not on PyPI) remain available.
set -e

APP_HOME="/usr/lib/movo"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/movo"
VENV="$DATA_HOME/venv"
VENV_PY="$VENV/bin/python3"
MARKER="$VENV/.deps-ok"

log() { echo "movo: $*" >&2; }

bootstrap() {
    log "first run: setting up dependencies (this happens once)…"
    mkdir -p "$DATA_HOME" || {
        log "cannot create $DATA_HOME; falling back to system python3"
        return 1
    }
    if [ ! -x "$VENV_PY" ]; then
        python3 -m venv --system-site-packages "$VENV" || {
            log "could not create virtualenv; falling back to system python3"
            return 1
        }
    fi
    "$VENV/bin/pip" install --upgrade pip >/dev/null 2>&1 || true
    if "$VENV/bin/pip" install \
        "PySide6-Essentials>=6.6" \
        "typesafe-sdk>=0.7.0" \
        "mss>=9.0" \
        "pynput>=1.7.6"; then
        touch "$MARKER"
        log "dependencies installed into $VENV"
        return 0
    fi
    log "dependency install failed (offline?). Retry with: movo --setup"
    return 1
}

# Explicit setup mode: run the bootstrap and exit.
if [ "$1" = "--setup" ]; then
    bootstrap
    exit $?
fi

# Auto-bootstrap on first run. If the venv isn't ready, try once; if it fails
# (e.g. offline) fall through to system python3 so the app can still open and
# report which capabilities are missing.
if [ ! -f "$MARKER" ]; then
    if [ -t 1 ]; then
        # Launched from a terminal: show progress inline.
        bootstrap || true
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        # Launched from the desktop menu: open a terminal so the one-time
        # download is visible instead of the app seeming to do nothing.
        x-terminal-emulator -e "sh -c '\"$0\" --setup; echo; echo Setup finished. You can close this window.; sleep 2'" || bootstrap || true
    else
        bootstrap || true
    fi
fi

if [ -x "$VENV_PY" ]; then
    PY="$VENV_PY"
else
    PY="$(command -v python3)"
fi

export PYTHONPATH="$APP_HOME${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m app.main "$@"
