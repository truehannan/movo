#!/bin/sh
# Post-install: fast, local-only, and non-interactive.
#
# IMPORTANT: package maintainer scripts must return quickly and must never do
# unbounded network work. Downloading PySide6 (~80 MB) here would hold the dpkg
# lock and make the install appear to hang forever. Instead we only do instant
# local setup and refresh caches; the heavy PyPI dependencies are installed on
# first launch by the app's bootstrap (or via `movo --setup`).
set -e

if [ "$1" = "configure" ]; then
    # Refresh desktop + icon caches when the tools are present (fast, local).
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -t /usr/share/icons/hicolor 2>/dev/null || true
    fi
fi

exit 0
