#!/bin/sh
# Pre-removal.
#
# The runtime virtualenv now lives per-user under ~/.local/share/movo (created
# on first launch), which a system package cannot enumerate or remove for every
# user. We only clean up any legacy system-path venv from older versions here;
# per-user data intentionally persists across reinstalls (users can delete
# ~/.local/share/movo themselves).
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -rf /usr/lib/movo/venv 2>/dev/null || true
fi

exit 0
