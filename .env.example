# Local agent runtime configuration.
# Copy to .env and fill in. NEVER commit .env. Store-publishing secrets do NOT
# belong here — they live only in GitHub Secrets (see README).

# TypeSafe / Jev decision model API key (used by the LOCAL agent service only).
TYPESAFE_API_KEY=

# Text-generation helper model (for TYPE_TEXT values). OpenAI-compatible.
TEXT_MODEL_API_KEY=
TEXT_MODEL=
TEXT_MODEL_BASE_URL=

# Local agent service bind address (loopback only by default).
AGENT_HOST=127.0.0.1
AGENT_PORT=8766
